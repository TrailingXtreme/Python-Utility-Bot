# =============================================================
#  .env.example
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# =============================================================


# ── Discord ───────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
BOT_DEBUG=false
# Short git commit SHA injected at deploy time (e.g. by CI).
# Leave as "master" for local development.
GIT_SHA=master


# ── PostgreSQL ────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
# For local Docker (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://botuser:botpassword@localhost:5432/discordbot


# ── Lavalink ──────────────────────────────────────────────────
# Matches the defaults in docker-compose.yml and lavalink/application.yml.
# Change password in both files if deploying to a public server.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_HTTPS=false


# ── Spotify  (via LavaSrc plugin in Lavalink) ─────────────────
# Create an app at https://developer.spotify.com/dashboard
# Used for resolving Spotify track / playlist URLs in the music cog.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret


# ── External APIs ─────────────────────────────────────────────
# RapidAPI key — used by the Fun cog (dad jokes).
# Get one at https://rapidapi.com/
JOKE_API=your_rapidapi_key

# A hard-to-guess random string used as an internal identifier for vote data.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_ID=replace_with_random_hex_string


# ── Algolia (Discord Developer Docs search) ───────────────────
# These are the public read-only keys for the discord.dev docs index.
# Only change if you run your own Algolia index.
ALGOLIA_SEARCH_APP_ID=BH4D9OD16A
ALGOLIA_SEARCH_API_KEY=f37d91bd900bbb124c8210cca9efcc01


# ── Optional integrations ─────────────────────────────────────
# top.gg token — for bot listing votes (currently unused in code).
TOPGGTOKEN=
# GitHub personal access token — for future GitHub API calls.
GITHUB_TOKEN=